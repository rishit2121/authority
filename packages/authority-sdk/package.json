{
  "name": "@authority/sdk",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "TypeScript client for the Authority developer API. Install from your Authority deployment: npm install https://<your-authority-url>/sdk/authority-sdk.tgz",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  }
}
