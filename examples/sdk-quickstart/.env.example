# Copy to .env (never commit it). Values come from the Authority dashboard's Setup page.
AUTHORITY_URL=http://localhost:3000
AUTHORITY_BACKEND_API_KEY=authority_dk_replace_me
AUTHORITY_AGENT_ID=00000000-0000-0000-0000-000000000000
AUTHORITY_AGENT_RUNTIME_KEY=authority_rk_replace_me

# The Slack connection YOUR app chose for this user (connections.list on the backend client shows them).
SLACK_CONNECTION_ID=00000000-0000-0000-0000-000000000000

# Your app's authenticated user id. Becomes the Authority customer's externalId.
AUTHORITY_USER_ID=user-123

# Optional: the id of the event that triggered this action. Reusing it never posts twice.
# EVENT_ID=deploy-2026-11-17-001
