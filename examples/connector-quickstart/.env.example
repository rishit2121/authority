# Shared by every connector -- see docs/task-lifecycle and Settings -> Applications -> Backend credentials.
AUTHORITY_URL=http://localhost:3000
AUTHORITY_BACKEND_API_KEY=authority_dk_...
AUTHORITY_AGENT_ID=...
AUTHORITY_AGENT_RUNTIME_KEY=authority_rk_...
CUSTOMER_ID=...

# Optional: resume a specific prior run instead of starting a new logical one.
# RUN_ID=...

# Optional for gmail/stripe/slack/postgres/custom-api: the exact connection to
# use. If unset, the first connection of that connector usable by CUSTOMER_ID
# is used (must already be delegated to this customer).
# CONNECTION_ID=...

# Optional for github only: the exact repository to use. If unset, the first
# repository delegated to CUSTOMER_ID is used.
# REPOSITORY_ID=...
# GITHUB_REPO_FULL_NAME=acme/widgets
# GITHUB_ISSUE_NUMBER=1

# Optional overrides for stripe/slack's fixed demo operation:
# STRIPE_PAYMENT_ID=pi_1demo
# SLACK_CHANNEL_ID=C000000

# Required for postgres: no fixed query exists across tenants -- this must
# name a query YOU already published for this connection (Settings ->
# Integrations -> PostgreSQL -> Published queries).
# POSTGRES_TOOL=postgres_xxxxx.get_customer_orders
# POSTGRES_OPERATION=get_customer_orders
# POSTGRES_RESOURCE=cust_1
# POSTGRES_ARGS_JSON={"customerId":"cust_1"}

# Required for custom-api: no fixed operation exists across tenants -- this
# must name an operation YOU already published for this connection
# (Settings -> Integrations -> Custom API -> Published operations).
# CUSTOM_API_TOOL=custom_xxxxx.get_order
# CUSTOM_API_OPERATION=get_order
# CUSTOM_API_RESOURCE=4821
# CUSTOM_API_ARGS_JSON={"orderId":"4821"}
