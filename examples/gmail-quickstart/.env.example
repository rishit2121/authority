# Copy to .env.local in this directory (gitignored) and fill in real values.
# Never commit this file with real secrets.

# This Authority deployment's origin.
AUTHORITY_URL=http://localhost:3000

# Settings -> Applications -> (your application) -> Backend credentials -> New credential.
AUTHORITY_BACKEND_API_KEY=authority_dk_...

# Agents -> New agent, then that agent -> Issue runtime credential.
AUTHORITY_AGENT_ID=00000000-0000-0000-0000-000000000000
AUTHORITY_AGENT_RUNTIME_KEY=authority_rk_...

# An opaque id your own backend already uses for this end user. The
# customer and their Gmail connection are both resolved/created by this
# script; the connection step is interactive (Google consent) only the
# first time one does not already exist for this external id.
CUSTOMER_EXTERNAL_ID=quickstart-customer
