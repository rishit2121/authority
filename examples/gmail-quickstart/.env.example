# Copy to .env.local in this directory (gitignored) and fill in real values.
# Never commit this file with real secrets.

# This Authority deployment's origin. If your server runs on a port other
# than 3000 (Authority's own default, `npm run dev`), also set
# AUTHORITY_PUBLIC_URL to the same value in *that server's* environment --
# the embedded Gmail connect flow builds its OAuth redirect URI from
# AUTHORITY_PUBLIC_URL (falling back to localhost:3000 in development, see
# src/lib/connectors/shared/public-base-url.ts), not from this script's own
# AUTHORITY_URL.
AUTHORITY_URL=http://localhost:3000

# Settings -> Applications -> (your application) -> Backend credentials -> New credential.
AUTHORITY_BACKEND_API_KEY=authority_dk_...

# Settings -> Applications -> (your application) -> Automation -- allow-list
# "gmail.list_labels" there so this quickstart's task activates automatically
# instead of waiting on a dashboard approval. This tool has its own dedicated
# registry permission, disjoint from Gmail's other read operations, so this
# can never grant message-reading access. Optional: without it, the script
# still works, it just stops at "awaiting_approval" until a human activates
# the contract once from the dashboard.

# Agents -> New agent, then that agent -> Issue runtime credential.
AUTHORITY_AGENT_ID=00000000-0000-0000-0000-000000000000
AUTHORITY_AGENT_RUNTIME_KEY=authority_rk_...

# An opaque id your own backend already uses for this end user. The
# customer and their Gmail connection are both resolved/created by this
# script; the connection step is interactive (Google consent) only the
# first time one does not already exist for this external id.
CUSTOMER_EXTERNAL_ID=quickstart-customer

# To reuse an already-connected customer from an earlier run (e.g. a prior
# live-test) instead, set CUSTOMER_ID to their existing id (Settings ->
# Applications -> (your application) -> Customers) and leave
# CUSTOMER_EXTERNAL_ID unset -- this skips customer creation/lookup
# entirely and goes straight to checking their existing connections.
# CUSTOMER_ID=00000000-0000-0000-0000-000000000000
