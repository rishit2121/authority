# Copy to .env.local in this directory (gitignored) and fill in real values.
# Never commit this file with real secrets.

# ---- Authority credentials ----
AUTHORITY_URL=http://localhost:3000
AUTHORITY_BACKEND_API_KEY=authority_dk_...
AUTHORITY_AGENT_ID=00000000-0000-0000-0000-000000000000
AUTHORITY_AGENT_RUNTIME_KEY=authority_rk_...

# The customer id of an ALREADY-CONNECTED Gmail customer -- run
# examples/gmail-quickstart first if you don't have one yet. This example
# does not open a new connection; it only demonstrates what a model-driven
# agent can and cannot do once a task is ready to run.
CUSTOMER_ID=00000000-0000-0000-0000-000000000000

# ---- Model credentials (separate from Authority; never sent to Authority) ----
# A real OpenAI API key for the model that decides which tool to call from
# the filtered manifest. If unset, this script runs in --manual mode
# instead: it makes the exact same two tool calls a model would have, with
# no model call at all -- so the authorization/denial behavior below is
# fully demonstrable without any model credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
