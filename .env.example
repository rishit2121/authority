# Authority — environment template.
#
# Copy to `.env.local` (git-ignored) and fill in values from your Supabase
# project: Dashboard → Project Settings → API.
#
# Only these two variables are public. Anything prefixed NEXT_PUBLIC_ is
# inlined into the browser bundle, so a secret must never be added here.

# Project URL, e.g. https://abcdefghijklmnopqrst.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). This key is designed to be public: it
# carries no privileges of its own and every request it makes is still subject
# to row level security.
#
# Legacy projects issued an "anon" JWT (eyJ...) instead. That key is accepted
# here as a fallback under NEXT_PUBLIC_SUPABASE_ANON_KEY, so an older project
# keeps working without setting two public keys at once. Prefer the
# publishable key for anything new.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, legacy only. Leave unset when PUBLISHABLE_KEY is present.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ---------------------------------------------------------------------------
# NOT part of this file. Do not add either of the following:
#
#   * A service-role or secret key (sb_secret_... / service_role JWT). Nothing
#     in this application uses one. It would bypass every RLS policy, and
#     under a NEXT_PUBLIC_ prefix it would ship to the browser.
#   * Supabase CLI credentials. Those live in `.supabase-cli.env`, also
#     git-ignored, and are read only by migration and database-test scripts:
#
#       SUPABASE_ACCESS_TOKEN=sbp_...
#       SUPABASE_DB_PASSWORD=...
#       SUPABASE_PROJECT_REF=...
# ---------------------------------------------------------------------------


# Password used by the authenticated Playwright suite to sign in as the users
# created by supabase/seed.sql. Development fixture only; defaults to the
# value in that file when unset.
# E2E_TEST_PASSWORD=

# --- Part 5: semantic risk (shadow mode). All optional. ---------------------
# Only needed if a tenant selects the `openai_compatible` semantic provider.
# Server-side only; never entered through the UI and never stored in the database.
# SEMANTIC_PROVIDER_API_KEY=
# Optional; https only. Defaults to https://api.openai.com/v1
# SEMANTIC_PROVIDER_BASE_URL=

# --- Part 6: trusted gateway. REQUIRED for /api/v1/*. ------------------------
# The dedicated `authority_gateway` database login (NOT the service-role key).
# Generate/rotate with: npm run gateway:provision  (needs SUPABASE_DB_PASSWORD in .supabase-cli.env)
# Use the transaction pooler (port 6543). Server-side only; never commit it.
# GATEWAY_DATABASE_URL=postgresql://authority_gateway.<project-ref>:<password>@<pooler-host>:6543/postgres
# Optional: PEM CA bundle to verify the pooler's certificate (recommended in production).
# GATEWAY_DATABASE_CA=
# Optional: connection pool size per server instance (default 5).
# GATEWAY_DATABASE_POOL_MAX=5
# Optional zero-downtime provider-key rotation (see docs/gateway/SECRETS.md).
# SEMANTIC_PROVIDER_API_KEY_SECONDARY=

# --- Part 7: GitHub connector. See docs/github/SETUP.md. -------------------------
# disabled (default) | mock (development only; refused in production unless AUTHORITY_ALLOW_MOCK_GITHUB=1) | live
# GITHUB_EXECUTION_MODE=disabled
# Public origin of this deployment (callback/webhook/redirect base). Required in production.
# AUTHORITY_PUBLIC_URL=https://authority.example.com
# Live mode only. All server-side; keep the key in an ignored file (./.secrets/ is git-ignored).
# GITHUB_APP_ID=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_SLUG=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_APP_PRIVATE_KEY_FILE=./.secrets/github-app.pem
# (or GITHUB_APP_PRIVATE_KEY / GITHUB_APP_PRIVATE_KEY_BASE64)
# Production readiness FAILS unless GATEWAY_DATABASE_CA is set (AUTHORITY_DEPLOYMENT=local relaxes it for a local `next start` only).

# --- Part 8: operations (all optional). See docs/ops/OPERATIONS.md ---------
# 24+ random characters. Enables POST /api/internal/maintenance for an external scheduler
# (.github/workflows/maintenance.yml); the endpoint does not exist without it.
# MAINTENANCE_TOKEN=
# In-process reconciliation interval in seconds (60-3600, default 300). AUTHORITY_SCHEDULER=off disables it.
# MAINTENANCE_INTERVAL_SECONDS=300
# AUTHORITY_SCHEDULER=off
# LOCAL/CI ONLY: connect to a throwaway local Postgres without TLS. Ignored by production processes and flagged by
# `npm run check:production`.
# GATEWAY_DATABASE_SSL=disable


# --- Invite-only pilot (optional). See docs/ops/PILOT_ACCESS.md -------------------
# New-request email to the pilot owner via Resend. Unset = requests are still saved; status "not_configured".
# RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Authority <pilot@yourdomain.com>".
# PILOT_NOTIFY_FROM=
# Optional salt for the hashed client IP used to rate-limit the public request form.
# PILOT_IP_SALT=
