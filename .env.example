# Authority — environment template.
#
# Copy to `.env.local` (git-ignored) and fill in values from your Supabase
# project: Dashboard → Project Settings → API.
#
# Only these two variables are public. Anything prefixed NEXT_PUBLIC_ is
# inlined into the browser bundle, so a secret must never be added here.

# Project URL, e.g. https://abcdefghijklmnopqrst.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). This key is designed to be public: it
# carries no privileges of its own and every request it makes is still subject
# to row level security.
#
# Legacy projects issued an "anon" JWT (eyJ...) instead. That key is accepted
# here as a fallback under NEXT_PUBLIC_SUPABASE_ANON_KEY, so an older project
# keeps working without setting two public keys at once. Prefer the
# publishable key for anything new.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, legacy only. Leave unset when PUBLISHABLE_KEY is present.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ---------------------------------------------------------------------------
# NOT part of this file. Do not add either of the following:
#
#   * A service-role or secret key (sb_secret_... / service_role JWT). Nothing
#     in this application uses one. It would bypass every RLS policy, and
#     under a NEXT_PUBLIC_ prefix it would ship to the browser.
#   * Supabase CLI credentials. Those live in `.supabase-cli.env`, also
#     git-ignored, and are read only by migration and database-test scripts:
#
#       SUPABASE_ACCESS_TOKEN=sbp_...
#       SUPABASE_DB_PASSWORD=...
#       SUPABASE_PROJECT_REF=...
# ---------------------------------------------------------------------------


# Password used by the authenticated Playwright suite to sign in as the users
# created by supabase/seed.sql. Development fixture only; defaults to the
# value in that file when unset.
# E2E_TEST_PASSWORD=
